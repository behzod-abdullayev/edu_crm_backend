<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Exam Reminder: {{examTitle}}</title></head>
<body style="margin:0;padding:0;background:#f4f7fa;font-family:Arial,sans-serif">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f7fa;padding:40px 0">
    <tr><td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1)">
        <tr><td style="background:#f59e0b;padding:32px 40px;text-align:center">
          <div style="font-size:36px">⏰</div>
          <h1 style="color:#fff;margin:8px 0 0;font-size:22px">Exam Reminder</h1>
        </td></tr>
        <tr><td style="padding:40px">
          <p style="color:#374151;font-size:15px;margin:0 0 20px">Hi <strong>{{studentName}}</strong>,</p>
          <p style="color:#6b7280;font-size:15px;line-height:1.6;margin:0 0 24px">This is a reminder about your upcoming exam:</p>
          <div style="background:#fffbeb;border:1px solid #fcd34d;border-radius:8px;padding:20px;margin-bottom:24px">
            <h2 style="color:#92400e;margin:0 0 12px;font-size:20px">{{examTitle}}</h2>
            <table width="100%" cellpadding="0" cellspacing="0">
              <tr><td style="padding:6px 0;color:#6b7280;font-size:14px;width:40%">Start Time</td><td style="padding:6px 0;color:#111827;font-weight:600">{{startAt}}</td></tr>
              <tr><td style="padding:6px 0;color:#6b7280;font-size:14px">Duration</td><td style="padding:6px 0;color:#111827;font-weight:600">{{duration}} minutes</td></tr>
            </table>
          </div>
          {{#if instructions}}
          <div style="background:#f9fafb;border-radius:6px;padding:16px 20px;margin-bottom:24px">
            <p style="color:#374151;font-size:14px;font-weight:600;margin:0 0 8px">📋 Instructions</p>
            <p style="color:#6b7280;font-size:14px;line-height:1.6;margin:0">{{instructions}}</p>
          </div>
          {{/if}}
          <div style="background:#fef2f2;border-radius:6px;padding:12px 16px">
            <p style="color:#991b1b;font-size:13px;margin:0">⚠️ Please ensure you are on time. Late arrivals may not be permitted.</p>
          </div>
        </td></tr>
        <tr><td style="background:#f9fafb;padding:20px 40px;border-top:1px solid #e5e7eb;text-align:center">
          <p style="color:#9ca3af;font-size:13px;margin:0">EduCRM · Best of luck on your exam!</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
