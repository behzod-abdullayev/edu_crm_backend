<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>New Homework: {{homeworkTitle}}</title></head>
<body style="margin:0;padding:0;background:#f4f7fa;font-family:Arial,sans-serif">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f7fa;padding:40px 0">
    <tr><td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1)">
        <tr><td style="background:#6366f1;padding:32px 40px;text-align:center">
          <div style="font-size:36px">📚</div>
          <h1 style="color:#fff;margin:8px 0 0;font-size:22px">New Homework Assigned</h1>
          <p style="color:rgba(255,255,255,.8);margin:4px 0 0;font-size:14px">{{courseName}}</p>
        </td></tr>
        <tr><td style="padding:40px">
          <p style="color:#374151;font-size:15px;margin:0 0 20px">Hi <strong>{{studentName}}</strong>,</p>
          <p style="color:#6b7280;font-size:15px;line-height:1.6;margin:0 0 24px">Your teacher has assigned new homework:</p>
          <div style="background:#f5f3ff;border-left:4px solid #6366f1;padding:16px 20px;border-radius:0 6px 6px 0;margin-bottom:24px">
            <p style="color:#4338ca;font-size:18px;font-weight:700;margin:0 0 4px">{{homeworkTitle}}</p>
            <p style="color:#6b7280;font-size:13px;margin:0">Course: {{courseName}}</p>
          </div>
          <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:28px">
            <tr>
              <td style="background:#fef3c7;border-radius:6px;padding:12px 16px;text-align:center">
                <p style="color:#92400e;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin:0 0 4px">DUE DATE</p>
                <p style="color:#78350f;font-size:16px;font-weight:700;margin:0">{{dueDate}}</p>
              </td>
            </tr>
          </table>
          <div style="text-align:center">
            <a href="{{submitUrl}}" style="background:#6366f1;color:#fff;padding:14px 32px;border-radius:6px;text-decoration:none;font-size:15px;font-weight:600;display:inline-block">Submit Homework →</a>
          </div>
        </td></tr>
        <tr><td style="background:#f9fafb;padding:20px 40px;border-top:1px solid #e5e7eb;text-align:center">
          <p style="color:#9ca3af;font-size:13px;margin:0">EduCRM · Good luck with your assignment!</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
