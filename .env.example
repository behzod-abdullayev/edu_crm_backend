# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001
APP_URL=http://localhost:4001
API_PREFIX=api

# ─── Database (PostgreSQL only — NO Redis) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here
DB_NAME=edu_crm
DB_SSL=false
DB_LOGGING=true

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-me
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username@example.com
MAIL_PASS=your-smtp-password-here
MAIL_FROM_NAME=EduCRM
MAIL_FROM_ADDRESS=noreply@yourdomain.com
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-here
EMAIL_FROM_NAME=EduCRM
EMAIL_FROM=noreply@yourdomain.com

# ─── SMS ───────────────────────────────────────────────────────────────────────
# SMS_PROVIDER options: console (default), twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM_NUMBER=+1234567890

# ─── 2FA ───────────────────────────────────────────────────────────────────────
TWO_FACTOR_APP_NAME=EduCRM

# ─── Certificates ──────────────────────────────────────────────────────────────
CERTIFICATE_VERIFY_BASE_URL=http://localhost:4001

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOADS_DEST=./uploads
UPLOADS_MAX_SIZE_MB=50
UPLOADS_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,video/mp4

# ─── AWS S3 (used only if STORAGE_PROVIDER=s3) ────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ROOT_DOMAIN=localhost:3000

# ─── Throttle ──────────────────────────────────────────────────────────────────
THROTTLE_TTL=900
THROTTLE_LIMIT=100

# ─── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── i18n ──────────────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en

# ─── Swagger ───────────────────────────────────────────────────────────────────
SWAGGER_ALWAYS_ENABLED=true

# ─── WebSocket ─────────────────────────────────────────────────────────────────
WS_CORS_ORIGINS=http://localhost:3000
